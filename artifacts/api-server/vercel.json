{
  "version": 2,
  "builds": [
    { "src": "api/geocode.js", "use": "@vercel/node" },
    { "src": "api/healthz.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/geocode", "dest": "/api/geocode.js" },
    { "src": "/api/healthz", "dest": "/api/healthz.js" },
    { "src": "/healthz",     "dest": "/api/healthz.js" }
  ]
}
